#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# 커밋 메시지 파일
COMMIT_MSG_FILE=$1

# 현재 브랜치명 가져오기
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# 브랜치명에서 MOONO-[숫자] 패턴 추출
ISSUE_KEY=$(echo "$BRANCH_NAME" | grep -oE 'MOONO-[0-9]+')

# 기존 메시지 읽기
CURRENT_MSG=$(cat "$COMMIT_MSG_FILE")

# ISSUE_KEY가 있고, 메시지에 아직 붙어있지 않은 경우 자동 prefix 추가
if [ -n "$ISSUE_KEY" ] && ! echo "$CURRENT_MSG" | grep -q "$ISSUE_KEY"; then
  echo "[$ISSUE_KEY] $CURRENT_MSG" > "$COMMIT_MSG_FILE"
fi
